# v1.1.0 — copy to .env and edit. Never commit .env.
# Development values below; production values in the comments (deploy/README.md).

# Production: DEBUG=0. Off, the server refuses to start without SECRET_KEY and DATABASE_URL.
DEBUG=True
# Production: 50+ random characters — it also signs every login token.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-in-production
# Production: the shop's domain, e.g. pos.example.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: https://pos.example.com — the Django admin's login form needs it
CSRF_TRUSTED_ORIGINS=
# Angular dev server; leave empty in production when nginx serves both from one origin
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Django's database. Production: postgres://pos:<POSTGRES_PASSWORD>@db:5432/pos
DATABASE_URL=postgres://pos:pos@db:5432/pos

# The Postgres container's own account, set when its volume is first created.
# The password must match the one in DATABASE_URL. Production: letters and
# digits only (it sits inside a URL) — openssl rand -hex 24
POSTGRES_DB=pos
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos

# Cookie flags — must be True behind HTTPS in production
AUTH_COOKIE_SECURE=False

# Production: gunicorn workers, about 2 × CPUs + 1
GUNICORN_WORKERS=3
# Production only: COMPOSE_FILE=docker-compose.prod.yml — plain `docker compose`
# then runs the production stack
